rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: for email lookup when sharing. Users can only write their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Pets: authenticated users can read/write (app enforces ownership)
    match /pets/{petId} {
      allow read, write: if request.auth != null;
    }
    
    // Tasks: authenticated users can read/write
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    
    // Completed tasks: authenticated users can read/write
    match /completed_tasks/{completedTaskId} {
      allow read, write: if request.auth != null;
    }
    
    // Shared access: owners create/update/delete; both parties can read
    match /shared_access/{shareId} {
      allow read: if request.auth != null && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.sharedWithUserId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUserId == request.auth.uid;
    }
  }
}
